# ════════════════════════════════════════
#  AnimeBot — Variáveis de Ambiente (exemplo)
#  Copia para .env e preenche com as tuas chaves.
#  Nunca commits o .env real — está no .gitignore.
# ════════════════════════════════════════

# ─── IA: Groq (principal) ───────────────────────────────────────
# Obter em: https://console.groq.com
# Modelo usado: llama-3.1-8b-instant
# Limite grátis: 30 req/min
GROQ_API_KEY=gsk_inserir_aqui_a_tua_chave

# ─── IA: Mistral (fallback) ─────────────────────────────────────
# Obter em: https://console.mistral.ai
# Modelo usado: mistral-small-latest
# Limite grátis: 10 req/min
MISTRAL_API_KEY=xxx_inserir_aqui_a_tua_chave

# ─── IA: Hugging Face (imagens / áudio) ─────────────────────────
# Obter em: https://huggingface.co/settings/tokens
# Rate-limit grátis: ilimitado (com throttling)
HF_API_KEY=hf_inserir_aqui_a_tua_chave

# ─── TTS: ElevenLabs (áudio narrado — opcional) ────────────────
# Obter em: https://elevenlabs.io
# Usado por modules/audio.js para gerar voz realista.
# Se não estiver definida, o bot usa fallbacks (Cartesia / google-tts).
ELEVENLABS_API_KEY=

# ─── Cloudflare Worker (geração de imagens SDXL — opcional) ────
# Obter em: https://dash.cloudflare.com/profile/api-tokens
# Usado apenas por deploy-worker.js para publicar o worker.
# O worker final exposto em *.workers.dev é referenciado em modules/imagem.js
# (adiciona CLOUDFLARE_IMAGE_WORKER=<url> depois de fazeres o deploy)
CF_API_TOKEN=

# ─── Servidor ──────────────────────────────────────────────────
# Porta do painel web (dashboard/server.js usa 3001 por defeito,
# server.js da raiz usa 3000 — ATENCAO: ver tarefa #6 do relatorio)
PORT=3000

# ─── Bot (opcional — futura centralização em config.js) ───────
# Prefixo de comandos
BOT_PREFIX=!
# Nome display do bot
BOT_NAME=AnimeBot
# Números de telefone admin (com código de país, separados por vírgula)
# Exemplo Moçambique: 25884xxxxxxx,25882xxxxxxx
ADMIN_NUMBERS=
